#!/usr/bin/env bash
set -euo pipefail

readonly state_dir=/var/lib/kilimanjaro
readonly marker="${state_dir}/firstboot-complete"

install -d -m 0755 "$state_dir" /etc/kilimanjaro

# Treat saved connections as metered. Users can opt out per connection later.
if command -v nmcli >/dev/null 2>&1; then
  while IFS= read -r uuid; do
    [[ -n "$uuid" ]] || continue
    nmcli connection modify uuid "$uuid" connection.metered yes || true
  done < <(nmcli --terse --fields UUID connection show 2>/dev/null || true)
fi

# Enable modem support only when a likely modem device is already present.
if compgen -G '/dev/cdc-wdm*' >/dev/null || compgen -G '/dev/ttyUSB*' >/dev/null; then
  systemctl enable --now ModemManager.service || true
fi

date --iso-8601=seconds > "$marker"
chmod 0644 "$marker"

