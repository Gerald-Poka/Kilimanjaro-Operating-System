Window.SetBackgroundTopColor(0.070, 0.078, 0.102);
Window.SetBackgroundBottomColor(0.035, 0.043, 0.071);

logo.image = Image("logo.png");
logo.image = logo.image.Scale(200, 200);
logo.sprite = Sprite(logo.image);
logo.sprite.SetX(Window.GetWidth() / 2 - logo.image.GetWidth() / 2);
logo.sprite.SetY(Window.GetHeight() / 2 - logo.image.GetHeight() / 2);

message_sprite = Sprite();

fun message_callback(text) {
    message_image = Image.Text(text, 0.95, 0.94, 0.91);
    message_sprite.SetImage(message_image);
    message_sprite.SetX(Window.GetWidth() / 2 - message_image.GetWidth() / 2);
    message_sprite.SetY(Window.GetHeight() * 0.76);
}

Plymouth.SetMessageFunction(message_callback);
