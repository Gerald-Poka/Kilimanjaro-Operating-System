# Kilimanjaro OS desktop service policy.
disable apt-daily.timer
disable apt-daily-upgrade.timer
enable bluetooth.service
enable NetworkManager.service
enable systemd-timesyncd.service
enable sddm.service
enable ufw.service
enable kilimanjaro-firstboot.service
enable kilimanjaro-netmeter.timer

# Printing is a core school requirement. cups-browsed discovers network
# printers over mDNS, which requires Avahi. Disable avahi-daemon.service
# only if site network policy forbids mDNS on the local link; USB and
# already-configured printers keep working either way.
enable cups.service
enable cups-browsed.service
enable avahi-daemon.service

# ModemManager is enabled conditionally by kilimanjaro-firstboot, and only
# when a modem is actually present.
disable ModemManager.service

# Installed for remote administration, but never started without an
# explicit decision by the site administrator.
disable ssh.service

# Scanning is on demand via the simple-scan front end; no service needed.