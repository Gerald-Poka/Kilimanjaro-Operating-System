# Kilimanjaro OS build identity and Debian base.
OS_NAME="Kilimanjaro OS"
OS_ID="kilimanjaro"
OS_VERSION_ID="0.1.0"
OS_VERSION_CODENAME="uhuru"
KILIMANJARO_PACKAGE_VERSION="0.1.0-1"

DEBIAN_SUITE="trixie"
DEBIAN_MIRROR="https://deb.debian.org/debian"
DEBIAN_SECURITY_MIRROR="https://security.debian.org/debian-security"
ARCH="amd64"

# Backports stays configured at low priority so installed systems can opt into
# individual backported packages (gamescope, for example) with -t, without any
# backported package ever being selected automatically. sid is never used: it
# would pull an unstable userspace.
DEBIAN_BACKPORTS_SUITE="${DEBIAN_SUITE}-backports"

# The kernel deliberately comes from the stable suite, not backports.
#
# Linux 6.12 is the newest kernel the proprietary NVIDIA driver supports. As of
# this writing Debian ships nvidia-driver 550.163.01 in stable, backports and
# sid alike, and none of them build against Linux 7.x: 550.163.01 predates it by
# about two years and still references removed kernel and DRM internals
# (vm_area_struct::__vm_flags, in_irq(), dma_map_ops::map_resource, DRM atomic
# state .state, the DRM_DEBUG family). That is not a packaging oversight that a
# newer revision fixes -- sid itself, on a 7.2 kernel, carries the same
# unbuildable 550.163.01. Shipping 7.x would therefore mean either shipping
# nouveau with no NVIDIA acceleration or maintaining a private patch against
# proprietary source. Both were rejected in favour of a working NVIDIA driver.
#
# Raise this only together with a decision to re-verify DKMS against the
# selected kernel, and record the reasoning here.
KILIMANJARO_KERNEL_MIN_MAJOR=6

ISO_LABEL="KILIMANJARO_0_1"
ISO_BASENAME="kilimanjaro-os-0.1.0-amd64.iso"
LIVE_HOSTNAME="kilimanjaro"
LIVE_USERNAME="kilimanjaro"
LIVE_FULLNAME="Kilimanjaro Live User"
DESKTOP_SESSION="plasmax11"
DISPLAY_MANAGER_SERVICE="sddm.service"

DEFAULT_LOCALE="sw_TZ.UTF-8"
FALLBACK_LOCALE="en_GB.UTF-8"
DEFAULT_TIMEZONE="Africa/Dar_es_Salaam"

# Archive update channel. Empty by default: the build then ships no archive
# source and kilimanjaro-base/kilimanjaro-desktop cannot self-update, which is
# the honest state until public hosting exists. Set all three together to
# activate it; the build fails if the key does not match the fingerprint.
# KILIMANJARO_APT_REPO_KEY is a path to an ASCII-armoured public key on the
# build host. Never place a private key here.
KILIMANJARO_APT_REPO_URL=""
KILIMANJARO_APT_REPO_FINGERPRINT=""
KILIMANJARO_APT_REPO_KEY=""
